# The sidecar, with what it needs to read Anthropic's and OpenAI's traffic.
# Built from the repository root.
FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

FROM python:3.13-slim@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0

# inspect-ai and inspect-scout are installed from their git repositories
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        git \
 && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /src
# inspect-ai's and inspect-scout's main, as development installs them
# (CONTRIBUTING.md), and before the version below, which would otherwise be
# theirs too
RUN uv venv /src/.venv \
 && uv pip install --python /src/.venv/bin/python \
        git+https://github.com/UKGovernmentBEIS/inspect_ai.git \
        git+https://github.com/meridianlabs-ai/inspect_scout.git
# the package takes its version from git, which stays out of the image
ENV SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0
COPY pyproject.toml README.md ./
COPY src ./src
# --no-sources: pyproject.toml's [tool.uv.sources] would have uv build
# inspect-ai and inspect-scout from git again, under the version above, and
# nothing that depends on them takes 0.0.0. They are installed already.
RUN uv pip install --no-sources --python /src/.venv/bin/python ".[anthropic,openai,sidecar]"
ENV PATH=/src/.venv/bin:$PATH
# the example's rule, which the sentinel names as weather_rules/always_sunny
COPY examples/always_sunny/rule /rule
RUN uv pip install --python /src/.venv/bin/python --no-deps /rule

EXPOSE 8900
ENTRYPOINT ["python", "-m", "inspect_sentinel.sidecar", "--host", "0.0.0.0", "--port", "8900"]
