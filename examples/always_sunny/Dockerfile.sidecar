# The sidecar, with what it needs to read Anthropic's and OpenAI's traffic.
# Built from the repository root.
FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

FROM python:3.13-slim@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0

# uv.lock names inspect-ai and inspect-scout by a commit of their git
# repositories, which uv fetches
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        git \
 && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /src
# the image's own Python, and never one that uv downloads
ENV UV_PYTHON_DOWNLOADS=never
# Exactly the versions and hashes in uv.lock, as CI installs them: uv resolves
# no versions here, and the build fails if uv.lock doesn't agree with
# pyproject.toml. First what the package depends on, without the version
# below: inspect-ai and inspect-scout are built from git, and would take it too.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project --extra anthropic --extra openai --extra sidecar
# the package takes its version from git, which stays out of the image
ENV SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0
COPY README.md ./
COPY src ./src
RUN uv sync --locked --no-editable --extra anthropic --extra openai --extra sidecar
ENV PATH=/src/.venv/bin:$PATH
# the example's rule, which the sentinel names as weather_rules/always_sunny
COPY examples/always_sunny/rule /rule
RUN uv pip install --python /src/.venv/bin/python --no-deps /rule

EXPOSE 8900
ENTRYPOINT ["python", "-m", "inspect_sentinel.sidecar", "--host", "0.0.0.0", "--port", "8900"]
