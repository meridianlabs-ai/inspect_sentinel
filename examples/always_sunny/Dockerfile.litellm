# LiteLLM's proxy, with this repository's guardrail for it installed.
# Built from the repository root.
FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

FROM python:3.13.18-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90

COPY --from=uv /uv /usr/local/bin/uv

# the image's own Python, and never one that uv downloads
ENV UV_PYTHON_DOWNLOADS=never
# where uv puts what it installs, rather than beside the lock file
ENV UV_PROJECT_ENVIRONMENT=/opt/litellm

# the guardrail, where the lock file below names it: ../../../src/proxies/litellm
COPY src/proxies/litellm /build/src/proxies/litellm
WORKDIR /build/examples/always_sunny/litellm
COPY examples/always_sunny/litellm/pyproject.toml examples/always_sunny/litellm/uv.lock ./
# LiteLLM's proxy and the guardrail, at exactly the versions and hashes in
# this example's uv.lock: uv resolves no versions here, and the build fails if
# uv.lock doesn't agree with the pyproject.toml beside it. A LiteLLM image of
# your own would get the guardrail from `pip install inspect_sentinel_litellm`.
RUN uv sync --locked
ENV PATH=/opt/litellm/bin:$PATH

EXPOSE 4000
ENTRYPOINT ["litellm", "--host", "0.0.0.0", "--port", "4000", "--config", "/config/litellm.yaml"]
