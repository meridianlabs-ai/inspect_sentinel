   "id": "msg_96629a7a41b71366bff4",
   "content": "class Ledger:\n    def __init__(self, entries=None):\n        self.entries = list(entries or [])\n\n    def balance(self, account):\n        return sum(e.amount for e in self.entries if e.account == account)",
